int nahodneCislo(int min, int max) {
    return rand() % (max - min + 1) + min;
}

void pauza() {
    cout << "\n[Stiskni Enter pro pokracovani...]";
    cin.ignore();
    cin.get();
}

void vykresliCaru() {
    cout << "--------------------------------------------------\n";
}

struct Monstrum {
    string jmeno;
    string jmeno4Pad;
    int hp;
    int maxHP;
    int utok;
    bool jeMiniBoss;
    bool jeHlavniBoss;
    int chronarchPouziti = 0;
    bool jeZena = false;
};

void vypisStaty(string jmenoHrace, int hp, int maxHP, int mana, int maxMana,
                int attack, int level, int xp, int gold, string className) {
    cout << "\n=========== STATISTIKY POSTAVY (" << jmenoHrace << " - " << className << ") ===========\n";
    cout << "  Zivoty: " << hp << "/" << maxHP << endl;
    cout << "  Mana: " << mana << "/" << maxMana << endl;
    cout << "  Utok:   " << attack << endl;
    cout << "  Level:  " << level << "  |  XP: " << xp << "/20" << endl;
    cout << "  Zlato:  " << gold << endl;
    cout << "======================================================\n";
}

struct GeneratorData {
    string j1;
    string j4;
    bool zena;
};

// GENERACE MONSTER //
Monstrum generujBezneMonstrum() {
    GeneratorData jmena[16] = {
        {"Goblin", "Goblina", false}, {"Skeleton", "Skeletona", false}, {"Orc", "Orca", false},
        {"Zombie", "Zombika", false}, {"Spider", "Spidera", false}, {"Wolf", "Wolfa", false},
        {"Zakerna sousedka", "Zakernou sousedku", true}, {"Skret", "Skreta", false},
        {"Netopyr", "Netopyra", false}, {"Had", "Hada", false}, {"Slime", "Slimea", false},
        {"Krysodlak", "Krysodlaka", false}, {"Bandita", "Banditu", false}, {"Duch", "Ducha", false},
        {"Revizor", "Revizora", false}, {"Policista", "Policistu", false}
    };

    int index = nahodneCislo(0, 15);
    Monstrum m;
    m.jmeno = jmena[index].j1;
    m.jmeno4Pad = jmena[index].j4;
    m.jeZena = jmena[index].zena;
    m.maxHP = nahodneCislo(8, 13);
    m.hp = m.maxHP;
    m.utok = nahodneCislo(2, 4);
    m.jeMiniBoss = false;
    m.jeHlavniBoss = false;
    return m;
}

// FUNKCE PRO VESNICI //
void navstivVesnici(string jmenoHrace, int &hp, int &maxHP, int &mana, int &maxMana, int &attack, int &gold, string nazevVesnice) {
    int volba;
    while (true) {
        vykresliCaru();
        cout << "         PRAVE JSI VSTOUPIL DO VESNICE: " << nazevVesnice << "\n";
        vykresliCaru();
        cout << "Hrdina: " << jmenoHrace << " | Zlato: " << gold << " | Zivoty: " << hp << "/" << maxHP << " | Mana: " << mana << "/" << maxMana << "\n";
        cout << "\nCo zde chces podniknout?\n";
        cout << "1 - Odpocinout si a doplnit zivoty i manu na max (Stoji 5 zlata)\n";
        cout << "2 - Trvale zvysit maximalni zivoty +3 (Stoji 10 zlata)\n";
        cout << "3 - Trvale zvysit maximalni manu +2 (Stoji 10 zlata)\n";
        cout << "4 - Nabrousit zbran/klacek a zvysit utok +2 (Stoji 15 zlata)\n";
        cout << "5 - Odejit z vesnice a pokracovat v ceste\n";
        cout << "\nTvoje volba: ";
        cin >> volba;

        bool uspesnyNakup = false;

        if (volba == 1) {
            if (gold >= 5) {
                hp = maxHP;
                mana = maxMana;
                gold -= 5;
                cout << "\n[!] Vse bylo plne obnoveno.\n";
                uspesnyNakup = true;
            } else {
                cout << "\n[!] Nemas dostatek zlata!\n";
            }
        }
        else if (volba == 2) {
            if (gold >= 10) {
                maxHP += 3;
                hp += 3;
                gold -= 10;
                cout << "\n[!] Maximalni zivoty se zvysily.\n";
                uspesnyNakup = true;
            } else {
                cout << "\n[!] Nemas dostatek zlata!\n";
            }
        }
        else if (volba == 3) {
            if (gold >= 10) {
                maxMana += 2;
                mana += 2;
                gold -= 10;
                cout << "\n[!] Maximalni kapacita se zvysila.\n";
                uspesnyNakup = true;
            } else {
                cout << "\n[!] Nemas dostatek zlata!\n";
            }
        }
        else if (volba == 4) {
            if (gold >= 15) {
                attack += 2;
                gold -= 15;
                cout << "\n[!] Tvuj zakladni utok trvale vzrostl.\n";
                uspesnyNakup = true;
            } else {
                cout << "\n[!] Nemas dostatek zlata!\n";
            }
        }
        else if (volba == 5) {
            cout << "\nBalis si veci a opoustis bezpeci vesnice...\n";
            break;
        }
        else {
            cout << "\n[!] Neplatna volba, zkus to znovu.\n";
        }

        if (uspesnyNakup) {
            char chciNakupovat;
            cout << "\nChces ve vesnici jeste neco nakoupit? (a/n): ";
            cin >> chciNakupovat;
            if (chciNakupovat == 'n' || chciNakupovat == 'N') {
                cout << "\nOpoustis bezpeci vesnice a pokracujes v ceste...\n";
                break;
            }
        }
    }
    pauza();
}

bool bitva(string jmenoHrace, int &hp, int &maxHP, int &mana, int &maxMana, int &attack, int &level, int &xp, int &gold, string className, vector<Monstrum> nepratele) {
    int kolaSouboje = 0;

    bool jeTuBoss = false;
    for (size_t i = 0; i < nepratele.size(); i++) {
        if (nepratele[i].jeMiniBoss || nepratele[i].jeHlavniBoss) {
            jeTuBoss = true;
        }
    }

    bool hracNaTahu = !jeTuBoss;

    cout << "\n!!! SOUBOJ ZACINA !!!\n";
    for (size_t i = 0; i < nepratele.size(); i++) {
        string sloveso = nepratele[i].jeZena ? "vyskocila" : "vyskocil";
        cout << "Z krovi " << sloveso << ": " << nepratele[i].jmeno << " (HP: " << nepratele[i].hp << ")\n";
    }

    while (hp > 0) {
        bool vsichniMrtvi = true;
        for (size_t i = 0; i < nepratele.size(); i++) {
            if (nepratele[i].hp > 0) vsichniMrtvi = false;
        }

        if (vsichniMrtvi) {
            cout << "\n[Vitezstvi] Vsechna monstra v tomto setkani jsou po smrti.\n";
            return true;
        }

        if (hracNaTahu) {
            kolaSouboje++;

            for (size_t i = 0; i < nepratele.size(); i++) {
                if (nepratele[i].jeHlavniBoss && nepratele[i].hp > 0 && kolaSouboje % 5 == 0) {
                    nepratele[i].chronarchPouziti++;

                    int leceni = 25 + kolaSouboje;
                    int noveHP = nepratele[i].hp + leceni;
                    if (noveHP > nepratele[i].maxHP) noveHP = nepratele[i].maxHP;

                    cout << "\n>>> [SCHOPNOST CHRONARCHA] Casove smycky se prolinaji! <<<\n";
                    cout << "Zivoty Chronarcha se pretocily z " << nepratele[i].hp << " HP na " << noveHP << " HP! (+ " << leceni << " HP)\n";
                    nepratele[i].hp = noveHP;
                }
            }

            vsichniMrtvi = true;
            for (size_t i = 0; i < nepratele.size(); i++) {
                if (nepratele[i].hp > 0) vsichniMrtvi = false;
            }
            if (vsichniMrtvi) break;

            cout << "\nHrdina: " << jmenoHrace << " | HP: " << hp << "/" << maxHP << " | Mana: " << mana << "/" << maxMana << endl;
            for (size_t i = 0; i < nepratele.size(); i++) {
                if (nepratele[i].hp > 0) {
                    cout << "  [" << i + 1 << "] " << nepratele[i].jmeno << " (HP: " << nepratele[i].hp << ")\n";
                }
            }

            cout << "\nCo udelas?\n1 - Klasicky utok\n2 - Schopnost 1 (Stoji 2 many)\n3 - Schopnost 2 (Stoji 3 many)\n4 - Meditace (Obnovi 3 many, stoji tah)\nVolba: ";
            int fightChoice;
            cin >> fightChoice;

            if (fightChoice == 1) {
                int cil = 0;
                if (nepratele.size() > 1) {
                    cout << "Zadej cislo nepritele, na ktereho utocis: ";
                    cin >> cil;
                    cil--;
                }
                if (cil < 0 || cil >= (int)nepratele.size() || nepratele[cil].hp <= 0) {
                    cout << "\n[!] Neplatny cil utoku!\n";
                    kolaSouboje--;
                    continue;
                }

                int damage = nahodneCislo(max(1, attack / 3), attack);
                nepratele[cil].hp -= damage;
                cout << "\n[*] Uderil jsi " << nepratele[cil].jmeno4Pad << " za " << damage << " poskozeni.\n";
            }
            else if (fightChoice == 2) {
                if (mana >= 2) {
                    mana -= 2;

                    if (className == "Paladin") {
                        hp += 4;
                        if (hp > maxHP) hp = maxHP;
                        cout << "\n[*] Paladin pouzil Leceni a obnovil si 4 zivoty.\n";
                    }
                    else if (className == "Mage") {
                        hp += 3;
                        if (hp > maxHP + 5) hp = maxHP + 5;
                        cout << "\n[*] Mage vyvolal Magicky stit (+3 HP bariera).\n";
                    }
                    else if (className == "Lovec") {
                        int cil = 0;
                        if (nepratele.size() > 1) { cout << "Vyber cil pro jed: "; cin >> cil; cil--; }
                        if (cil >= 0 && cil < (int)nepratele.size() && nepratele[cil].hp > 0) {
                            nepratele[cil].hp -= 5;
                            cout << "\n[*] Lovec vystrelil Jedovatou strelu do " << nepratele[cil].jmeno4Pad << " za 5 poskozeni.\n";
                        }
                    }
                    else if (className == "Bezdomovec") {
                        int cil = 0;
                        if (nepratele.size() > 1) { cout << "Na koho budes zebrat?: "; cin >> cil; cil--; }
                        if (cil >= 0 && cil < (int)nepratele.size() && nepratele[cil].hp > 0) {
                            nepratele[cil].hp -= 5;
                            cout << "\n[*] Bezdomovec zacal urputne zebrat. " << nepratele[cil].jmeno4Pad << " utrpel trapnosti 5 poskozeni.\n";
                        }
                    }
                } else {
                    cout << "\n[!] Nedostatek zdroju!\n";
                    kolaSouboje--;
                    continue;
                }
            }
            else if (fightChoice == 3) {
                if (mana >= 3) {
                    mana -= 3;

                    if (className == "Paladin") {
                        cout << "\n[*] Paladin pouzil Uder svetlem! Zablesk zasahl vsechny!\n";
                        for (size_t i = 0; i < nepratele.size(); i++) {
                            if (nepratele[i].hp > 0) {
                                nepratele[i].hp -= 3;
                                cout << "  -> " << nepratele[i].jmeno << " utrpel 3 plosne poskozeni.\n";
                            }
                        }
                    }
                    else if (className == "Mage") {
                        int cil = 0;
                        if (nepratele.size() > 1) { cout << "Vyber cil pro Fireball: "; cin >> cil; cil--; }
                        if (cil < 0 || cil >= (int)nepratele.size() || nepratele[cil].hp <= 0) {
                            cout << "\n[!] Neplatny cil! Kouzlo selhalo, mana vracena.\n"; mana += 3; kolaSouboje--; continue;
                        }
                        int specialDamage = nahodneCislo(6, 10);
                        nepratele[cil].hp -= specialDamage;
                        cout << "\n[*] Vystrelil jsi Fireball do " << nepratele[cil].jmeno4Pad << " za " << specialDamage << " zraneni!\n";
                    }
                    else if (className == "Lovec") {
                        int cil = 0;
                        if (nepratele.size() > 1) { cout << "Vyber cil pro omraceni: "; cin >> cil; cil--; }
                        if (cil >= 0 && cil < (int)nepratele.size() && nepratele[cil].hp > 0) {
                            int dmg = nahodneCislo(6, 9);
                            nepratele[cil].hp -= dmg;
                            cout << "\n[*] Lovec pouzil Pruraznou ranu na " << nepratele[cil].jmeno4Pad << " za " << dmg << " poskozeni.\n";
                        }
                    }
                    else if (className == "Bezdomovec") {
                        int cil = 0;
                        if (nepratele.size() > 1) { cout << "Koho sokujes svacinou?: "; cin >> cil; cil--; }
                        if (cil >= 0 && cil < (int)nepratele.size() && nepratele[cil].hp > 0) {
                            int damageSvacina = 6 + (attack / 3);
                            nepratele[cil].hp -= damageSvacina;
                            hp += 4;
                            if (hp > maxHP) hp = maxHP;
                            cout << "\n[*] Bezdomovec nasel v popelnici starou svacu! Sokoval tim " << nepratele[cil].jmeno4Pad << " za " << damageSvacina << " poskozeni a sam ziskal silu (+4 HP).\n";
                        }
                    }
                } else {
                    cout << "\n[!] Nedostatek zdroju!\n";
                    kolaSouboje--;
                    continue;
                }
            }
            else if (fightChoice == 4) {
                mana += 3;
                if (mana > maxMana) mana = maxMana;
                cout << "\n[*] Dal jsi si dvacet na lavicce a obnovil 3 many.\n";
            }
            else {
                cout << "\n[!] Neplatna volba akce!\n";
                kolaSouboje--;
                continue;
            }

            for (size_t i = 0; i < nepratele.size(); i++) {
                if (nepratele[i].hp <= 0 && nepratele[i].hp > -999) {
                    cout << "\n>>> " << nepratele[i].jmeno << " padl" << (nepratele[i].jeZena ? "a" : "") << " k zemi! <<<\n";

                    int ziskXp = nepratele[i].jeHlavniBoss ? 50 : (nepratele[i].jeMiniBoss ? 25 : 10);
                    xp += ziskXp;
                    cout << "Ziskavas: " << ziskXp << " XP.\n";

                    if (nepratele[i].jeMiniBoss || nepratele[i].jeHlavniBoss || nahodneCislo(1, 2) == 1) {
                        int foundGold = nepratele[i].jeHlavniBoss ? nahodneCislo(25, 50) : (nepratele[i].jeMiniBoss ? nahodneCislo(10, 20) : nahodneCislo(1, 10));
                        gold += foundGold;
                        cout << "Nasel jsi u nej " << foundGold << " zlata!\n";
                    }

                    if (xp >= 20) {
                        level++;
                        xp -= 20;

                        int stareMaxHP = maxHP;
                        int staraMana = maxMana;
                        int staryAttack = attack;

                        maxHP += 5;
                        hp = maxHP;
                        maxMana += 2;
                        mana = maxMana;
                        attack += 2;

                        cout << "\n==================================";
                        cout << "\n      NOVY LEVEL POSTAVY (" << level << ")";
                        cout << "\n==================================";
                        cout << "\n  Zivoty: " << stareMaxHP << " -> " << maxHP;
                        cout << "\n  Mana:   " << staraMana << " -> " << maxMana << " (Plne obnovena)";
                        cout << "\n  Utok:   " << staryAttack << " -> " << attack;
                        cout << "\n==================================\n";
                    }
                    nepratele[i].hp = -999;
                }
            }
            hracNaTahu = false;
        }
        else {
            kolaSouboje++;
            cout << "\n--- Tah nepratel na bojisti ---\n";
            for (size_t i = 0; i < nepratele.size(); i++) {
                if (nepratele[i].hp > 0) {
                    hp -= nepratele[i].utok;

                    string koncovkaSlovesa = nepratele[i].jeZena ? "utocila a zpusobila" : "utoci a zpusobil";
                    cout << "  " << nepratele[i].jmeno << " " << koncovkaSlovesa << " ti " << nepratele[i].utok << " poskozeni.\n";
                    if (hp <= 0) return false;
                }
            }
            hracNaTahu = true;
        }
    }
    return false;
}

void potkejMoudrehoStroma(int &hp, int maxHP) {
    int volba;
    cout << "\n*Prichazis na osamocenou mitinu, kde stoji prastary strom.*\n";
    cout << "Strom: \"Zdravim te, pocestny. Odvazujes se pomerit sily sve mysli se mnou, moudrym stromem?\"\n";
    cout << "1 - Ano, prijimam hadanku\n2 - Ne, radsi odejdu\nVolba: ";
    cin >> volba;

    if (volba == 1) {
        cout << "\n===> Moudry Strom klade hadanku <===\n";
        cout << "Strom: \"Dobra tedy, ma hadanka zni: kazdy den na obloze se vznasi, radost nam prinasi a bubaky strasi. Co to je, pocestny?\"\n";
        cout << "1 - Slunce\n2 - Hrnec\n3 - Mesic\nVolba: ";
        cin >> volba;

        if (volba == 1) {
            cout << "\nStrom: \"Ha, koumak jsi koukam. No dobra, mou silou a magii ti navysuji zivoty o 2. Tak upaluj dal.\"\n";
            hp += 2;
            if (hp > maxHP) hp = maxHP;
        } else {
            cout << "\nStrom: \"Spatne! Tva mysl spi. Cit se oslaben! (-2 HP)\"\n";
            hp -= 2;
        }
    }
    pauza();
}

