#include <iostream>
#include <cstdlib>
#include <ctime>

using namespace std;

// FUNKCE PRO NAHODNE CISLO //

int nahodneCislo(int min, int max) {

    return rand() % (max - min + 1) + min;
}

// FUNKCE PRO VYPIS STATISTIK //

void vypisStaty(int hp, int maxHP, int mana, int maxMana,
                 int attack, int level, int xp, int gold) {

    cout << "\n----------- STATISTIKY -----------\n";

    cout << "Zivoty: " << hp << "/" << maxHP << endl;
    cout << "Mana: " << mana << "/" << maxMana << endl;
    cout << "Utok: " << attack << endl;
    cout << "Level: " << level << endl;
    cout << "XP: " << xp << endl;
    cout << "Zlato: " << gold << endl;

    cout << "----------------------------------\n";
}

// FUNKCE PRO VYPIS MONSTRA //

void vypisMonstrum(string monsterName) {

    cout << "\n-----------------------------";
    cout << "\n    OBJEVILO SE MONSTRUM";
    cout << "\n-----------------------------\n";

    cout << "\nPred tebou se objevil "
         << monsterName
         << "!\n";
}

int main() {

    srand(time(0));

// STATISTIKY HRACE //

    int hp, maxHP;
    int mana, maxMana;
    int attack;

    int gold = 10;
    int level = 1;
    int xp = 0;

    int vyber;
    int potvrzeni;

    string className;

    cout << "----- TEXTOVE RPG -----\n";

// VYBER POSTAVY //

    while (true) {

        cout << "\nVyber si postavu:\n";

        cout << "1 - Paladin\n";
        cout << "2 - Mage\n";

        cout << "\nTvoje volba: ";
        cin >> vyber;

// PALADIN //

        if (vyber == 1) {

            className = "Paladin";

            maxHP = 15;
            hp = 15;

            maxMana = 5;
            mana = 5;

            attack = 4;

            cout << "\nPostava: Paladin\n";
        }

// MAGE //

        else if (vyber == 2) {

            className = "Mage";

            maxHP = 10;
            hp = 10;

            maxMana = 10;
            mana = 10;

            attack = 5;

            cout << "\nPostava: Mage\n";
        }

// SPATNA VOLBA //

        else {

            cout << "\nNeplatna volba!\n";
            continue;
        }

// VYPIS STATISTIK //

        vypisStaty(hp, maxHP, mana, maxMana,
                    attack, level, xp, gold);

        cout << "\nChces tuto postavu?\n";
        cout << "1 = Ano\n";
        cout << "0 = Ne\n";

        cout << "\nTvoje volba: ";
        cin >> potvrzeni;

        if (potvrzeni == 1) {
            break;
        }
    }

    cout << "\n-----------------------------";
    cout << "\n     POSTAVA POTVRZENA";
    cout << "\n-----------------------------\n";

// NAHODNE MONSTRUM //

    int monsterHP;
    int monsterAttack;

    string monsterName;

    int randomMonster = nahodneCislo(1, 7);

    if (randomMonster == 1) {

        monsterName = "Goblin";
        monsterHP = 10;
        monsterAttack = 2;
    }

    else if (randomMonster == 2) {

        monsterName = "Skeleton";
        monsterHP = 12;
        monsterAttack = 3;
    }

    else if (randomMonster == 3) {

        monsterName = "Orc";
        monsterHP = 15;
        monsterAttack = 4;
    }

    else if (randomMonster == 4) {

        monsterName = "Zombie";
        monsterHP = 14;
        monsterAttack = 3;
    }

    else if (randomMonster == 5) {

        monsterName = "Spider";
        monsterHP = 8;
        monsterAttack = 5;
    }

    else if (randomMonster == 6) {

        monsterName = "Wolf";
        monsterHP = 11;
        monsterAttack = 4;
    }

// MINI BOSS //

    else {

        monsterName = "Dark Knight";
        monsterHP = 25;
        monsterAttack = 6;
    }

// VYPIS MONSTRA //

    vypisMonstrum(monsterName);

// SOUBOJ //

    while (hp > 0 && monsterHP > 0) {

        cout << "\n-----------------------------";
        cout << "\n           SOUBOJ";
        cout << "\n-----------------------------\n";

        cout << "\nTvoje zivoty: "
             << hp
             << "/"
             << maxHP
             << endl;

        cout << "Tvoje mana: "
             << mana
             << "/"
             << maxMana
             << endl;

        cout << monsterName
             << " - zivoty: "
             << monsterHP
             << endl;

        cout << "\n1 - Utok\n";
        cout << "2 - Leceni\n";
        cout << "3 - Specialni schopnost\n";

        int fightChoice;

        cout << "\nTvoje volba: ";
        cin >> fightChoice;

// NORMALNI UTOK //

        if (fightChoice == 1) {

            int damage = nahodneCislo(1, attack);

            monsterHP = monsterHP - damage;

            cout << "\nUderil jsi "
                 << monsterName
                 << " za "
                 << damage
                 << " poskozeni!\n";
        }

// LECENI //

        else if (fightChoice == 2) {

            if (mana >= 2) {

                hp = hp + 4;

                if (hp > maxHP) {
                    hp = maxHP;
                }

                mana = mana - 2;

                cout << "\nVylecil ses o 4 zivoty!\n";
            }

            else {

                cout << "\nNemas dost many!\n";
                continue;
            }
        }

// SPECIALNI SCHOPNOST //

        else if (fightChoice == 3) {

            if (mana >= 3) {

                int specialDamage;

// PALADIN ABILITY //

                if (className == "Paladin") {

                    specialDamage = nahodneCislo(5, 8);

                    cout << "\nPouzil jsi Svaty uder!\n";
                }

// MAGE ABILITY //

                else {

                    specialDamage = nahodneCislo(6, 10);

                    cout << "\nPouzil jsi Fireball!\n";
                }

                mana = mana - 3;

                monsterHP = monsterHP - specialDamage;

                cout << "Zpusobil jsi "
                     << specialDamage
                     << " poskozeni!\n";
            }

            else {

                cout << "\nNemas dost many!\n";
                continue;
            }
        }

// SPATNA VOLBA //

        else {

            cout << "\nNeplatna volba!\n";
            continue;
        }

// SMRT MONSTRA //

        if (monsterHP <= 0) {

            cout << "\n-----------------------------";
            cout << "\n      MONSTRUM PORAZENO";
            cout << "\n-----------------------------\n";

            cout << "\n"
                 << monsterName
                 << " byl porazen!\n";

// XP ODMENA //

            if (monsterName == "Dark Knight") {

                xp = xp + 25;

                cout << "\nZiskal jsi 25 XP!\n";
            }

            else {

                xp = xp + 10;

                cout << "\nZiskal jsi 10 XP!\n";
            }

// ZLATO ODMENA //

            int foundGold;

            if (monsterName == "Dark Knight") {

                foundGold = nahodneCislo(10, 20);
            }

            else {

                foundGold = nahodneCislo(1, 10);
            }

            gold = gold + foundGold;

            cout << "Nasel jsi "
                 << foundGold
                 << " zlata!\n";

// LEVEL SYSTEM //

            if (xp >= 20) {

                level = 2;

                maxHP = maxHP + 5;
                hp = maxHP;

                attack = attack + 2;

                cout << "\n-----------------------------";
                cout << "\n         LEVEL UP";
                cout << "\n-----------------------------\n";

                cout << "\Dosahl jsi 2 levelu!\n";
                cout << "Ziskal jsi vice zivotu a utoku!\n";
            }

// VYPIS ODMEN //

            cout << "\nAktualni XP: "
                 << xp
                 << endl;

            cout << "Aktualni zlato: "
                 << gold
                 << endl;

            break;
        }

// TAH MONSTRA //

        hp = hp - monsterAttack;

        cout << "\n"
             << monsterName
             << " te uderil za "
             << monsterAttack
             << " poskozeni!\n";

// SMRT HRACE //

        if (hp <= 0) {

            cout << "\n-----------------------------";
            cout << "\n          KONEC HRY";
            cout << "\n-----------------------------\n";

            cout << "\nZemrel jsi!\n";
        }
    }

    return 0;
}
